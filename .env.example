# --- Security ---
# Generate secure keys using: openssl rand -hex 32
SECRET_KEY=changethis
ENCRYPTION_KEY=changethis

# --- Database Credentials ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ironvault

# Note: Docker Compose will automatically construct the DATABASE_URL using these credentials.
# If running locally (without Docker), you may need to set DATABASE_URL manually here:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/ironvault